+        return e && e[0] == '1';
+    }();
+    if (trace_boundary) {
+        std::fprintf(stderr, "B1B_CALL_EXTERNAL_CHECK_BEGIN buffer=%p\n", (void *) buffer);
+        std::fflush(stderr);
+    }
+    ggml_expert_b1b_prov(7, (uintptr_t) buffer);
+    ggml_expert_b1b_helper_breadcrumb_ptr(161, 10, (uintptr_t) buffer);
+    ggml_expert_b1b_prov(8, (uintptr_t) buffer);
+    const bool is_external = ggml_backend_buffer_is_external_expert(buffer);
+    if (trace_boundary) {
+        std::fprintf(stderr, "B1B_CALL_EXTERNAL_CHECK_END result=%d buffer=%p\n", is_external ? 1 : 0, (void *) buffer);
+        std::fflush(stderr);
+    }
+    if (!is_external) {
+        ggml_expert_b1b_helper_breadcrumb(161, 11);
+        if (context) *context = nullptr;
+        if (base) *base = nullptr;
+        if (reserved) *reserved = 0;
+        ggml_expert_b1b_helper_breadcrumb(161, 12);
+        return false;
+    }
+    ggml_expert_b1b_helper_breadcrumb(161, 20);
+    if (trace_boundary) {
