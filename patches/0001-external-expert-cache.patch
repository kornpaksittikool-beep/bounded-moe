+static void ggml_backend_sched_b1b_probe_moe_nodes(ggml_backend_sched_t sched, struct ggml_cgraph * graph) {
+    const char * enabled = std::getenv("B1B_SCHEDULER_PROBE");
+    if (!enabled || enabled[0] != '1') return;
+    static uint64_t sequence = 0;
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        struct ggml_tensor * node = graph->nodes[i];
+        if (!node || node->op != GGML_OP_MUL_MAT_ID) continue;
+        const int backend_id = tensor_backend_id(node);
+        ggml_backend_t backend = backend_id >= 0 && backend_id < sched->n_backends ? sched->backends[backend_id] : nullptr;
+        ggml_backend_dev_t backend_dev = backend ? ggml_backend_get_device(backend) : nullptr;
+        const char * classification = backend_dev && ggml_backend_dev_type(backend_dev) == GGML_BACKEND_DEVICE_TYPE_CPU ? "CPU" :
+            backend_dev && ggml_backend_dev_type(backend_dev) == GGML_BACKEND_DEVICE_TYPE_GPU ? "GPU" : "OTHER";
+        struct ggml_tensor * src0 = node->src[0];
+        struct ggml_tensor * src1 = node->src[1];
+        struct ggml_tensor * src2 = node->src[2];
+        auto buffer_name = [](struct ggml_tensor * tensor) -> const char * {
+            if (!tensor) return "<none>";
+            ggml_backend_buffer_t buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+            return buffer ? ggml_backend_buft_name(ggml_backend_buffer_get_type(buffer)) : "<none>";
+        };
+        auto buffer_device = [](struct ggml_tensor * tensor) -> const char * {
+            if (!tensor) return "<none>";
+            ggml_backend_buffer_t buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+            if (!buffer) return "<none>";
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer));
+            return dev ? ggml_backend_dev_name(dev) : "CPU/NULL";
+        };
+        ggml_expert_storage_info info = {};
+        const bool validated_expert = src0 && ggml_expert_storage_lookup(src0, &info);
+        std::fprintf(stderr, "B1B_SCHED_MUL_MAT_ID sequence=%llu node=%s node_ptr=%p backend_id=%d backend=%s backend_device=%s backend_device_type=%d classification=%s src0=%s src0_type=%s src0_buffer=%s src0_device=%s src0_validated_expert=%d src0_layer=%d src0_kind=%d src1=%s src1_buffer=%s src1_device=%s src2=%s src2_buffer=%s src2_device=%s\n",
+            (unsigned long long) ++sequence, ggml_get_name(node), (void *) node, backend_id,
+            backend ? ggml_backend_name(backend) : "<none>", backend_dev ? ggml_backend_dev_name(backend_dev) : "<none>",
+            backend_dev ? (int) ggml_backend_dev_type(backend_dev) : -1, classification,
+            src0 ? ggml_get_name(src0) : "<none>", src0 ? ggml_type_name(src0->type) : "<none>", buffer_name(src0), buffer_device(src0), validated_expert ? 1 : 0,
+            validated_expert ? info.layer : -1, validated_expert ? info.kind : -1,
+            src1 ? ggml_get_name(src1) : "<none>", buffer_name(src1), buffer_device(src1),
+            src2 ? ggml_get_name(src2) : "<none>", buffer_name(src2), buffer_device(src2));
+    }
+}
