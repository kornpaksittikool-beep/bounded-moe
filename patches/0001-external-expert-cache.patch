+        std::fflush(stderr);
+    }
+    auto * ctx = (ggml_external_expert_context *) buffer->context;
+    ggml_expert_b1b_helper_breadcrumb(161, 21);
+    ggml_expert_b1b_helper_breadcrumb(161, 30);
+    if (context) *context = ctx;
+    ggml_expert_b1b_helper_breadcrumb(161, 31);
+    if (base) *base = ctx ? ctx->base : nullptr;
+    ggml_expert_b1b_helper_breadcrumb(161, 32);
+    if (reserved) *reserved = ctx ? ctx->reserved : 0;
+    ggml_expert_b1b_helper_breadcrumb(161, 40);
+    return true;
+}
