+    }
+    ggml_expert_b1b_helper_breadcrumb(162, 21);
+    const bool result = free_buffer == ggml_external_expert_free;
+    ggml_expert_b1b_helper_breadcrumb(162, 22);
+    if (trace_boundary) {
+        std::fprintf(stderr, "B1B_BUFFER_CHECK_RETURN result=%d buffer=%p\n", result ? 1 : 0, (void *) buffer);
+        std::fflush(stderr);
+    }
+    return result;
+}
