+// External expert storage is deliberately a separate buffer implementation.
+// Its address range is only a logical placeholder; CPU expert compute must
+// resolve real bytes through ggml_expert_resolve_ptr().
+struct ggml_external_expert_context {
+    void * base = nullptr;
+    size_t reserved = 0;
+};
+
+static void ggml_external_expert_fail(ggml_backend_buffer_t buffer, const char * op, const ggml_tensor * tensor) {
+    GGML_UNUSED(buffer);
+    ggml_expert_external_note_failure(op, tensor);
+    GGML_ABORT("external expert buffer content access is forbidden");
+}
+
+static void ggml_external_expert_free(ggml_backend_buffer_t buffer) {
+    ggml_expert_b1b_buffer_freed((uintptr_t) buffer);
+    auto * ctx = (ggml_external_expert_context *) buffer->context;
+#ifdef _WIN32
+    if (ctx && ctx->base) {
+        VirtualFree(ctx->base, 0, MEM_RELEASE);
+    }
+#else
+    GGML_UNUSED(ctx);
+#endif
+    delete ctx;
+}
+
+static void * ggml_external_expert_base(ggml_backend_buffer_t buffer) {
+    const char * e = std::getenv("B1B_TRACE_BUFFER_BOUNDARY");
+    const bool trace_boundary = e && e[0] == '1';
+    if (trace_boundary) { std::fprintf(stderr, "B1B_EXTERNAL_BASE_ENTER buffer=%p\n", (void *) buffer); std::fflush(stderr); }
+    if (trace_boundary) { std::fprintf(stderr, "B1B_EXTERNAL_CONTEXT_READ_BEGIN buffer=%p\n", (void *) buffer); std::fflush(stderr); }
+    auto * ctx = (ggml_external_expert_context *) buffer->context;
+    if (trace_boundary) { std::fprintf(stderr, "B1B_EXTERNAL_CONTEXT_READ_END context=%p\n", (void *) ctx); std::fflush(stderr); }
+    void * base = ctx->base;
+    if (trace_boundary) { std::fprintf(stderr, "B1B_EXTERNAL_BASE_RETURN base=%p context=%p\n", base, (void *) ctx); std::fflush(stderr); }
+    return base;
+}
+
+static void ggml_external_expert_memset(ggml_backend_buffer_t buffer, ggml_tensor * tensor, uint8_t, size_t, size_t) {
+    ggml_external_expert_fail(buffer, "clear", tensor);
+}
+static void ggml_external_expert_set(ggml_backend_buffer_t buffer, ggml_tensor * tensor, const void *, size_t, size_t) {
+    ggml_external_expert_fail(buffer, "set", tensor);
+}
+static void ggml_external_expert_get(ggml_backend_buffer_t buffer, const ggml_tensor * tensor, void *, size_t, size_t) {
+    ggml_external_expert_fail(buffer, "get", tensor);
+}
+static bool ggml_external_expert_copy(ggml_backend_buffer_t buffer, const ggml_tensor * src, ggml_tensor *) {
+    ggml_external_expert_fail(buffer, "copy", src);
+    return false;
+}
