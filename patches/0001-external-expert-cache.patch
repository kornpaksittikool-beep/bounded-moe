+    GGML_UNUSED(buft);
+}
+
+// External expert storage is reserved address space with no committed pages. It is owned by
+// the CPU backend but is NOT directly readable host memory, so is_host must be false.
+// Reporting host here is what let ggml_backend_sched offload a MoE weight op to CUDA and
+// memcpy the reserved range, which faults once the batch reaches the CUDA offload minimum.
+static bool ggml_backend_cpu_external_expert_buffer_type_is_host(ggml_backend_buffer_type_t buft) {
+    return false;
+
+    GGML_UNUSED(buft);
